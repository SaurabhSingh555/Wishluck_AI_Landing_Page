{
  "name": "wishluck-ai-landing-page-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI landing page builder for Shopify: product/brand analysis, competitor research, persistent layout memory and editable OS 2.0 Liquid sections.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "tsc -p frontend/tsconfig.json --noEmit && vite build --config frontend/vite.config.ts",
    "start": "cross-env NODE_ENV=production tsx backend/src/server.ts",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "lint": "eslint backend frontend tests",
    "db:push": "drizzle-kit push --config backend/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config backend/drizzle.config.ts",
    "export:shopify": "tsx backend/scripts/export-shopify.ts",
    "test:e2e": "node tests/e2e.mjs",
    "test:feedback": "node tests/feedback-and-second-run.mjs"
  },
  "dependencies": {
    "@playwright/test": "^1.65.1",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "express": "^5.1.0",
    "jszip": "^3.10.2",
    "lighthouse": "^13.6.0",
    "liquidjs": "^10.30.1",
    "mysql2": "^3.14.3",
    "playwright-core": "^1.65.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/express": "^5.0.3",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "8.5.23",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9"
  }
}
