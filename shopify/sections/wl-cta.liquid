{%- if section.settings.show_section -%}
{%- render 'wl-style', section: section -%}
{%- assign s = section.settings -%}
<section class="wl-section wl-s--cta wl-layout--{{ s.layout }} wl-align--{{ s.align }}" aria-labelledby="wl-h-{{ section.id }}">
  <div class="wl-wrap">
    {%- assign crumb = product.collections.first -%}
    <div class="wl-cta">
      <div>
        <h2 id="wl-h-{{ section.id }}">{{ s.heading | escape }}</h2>
        {%- if s.text != blank -%}<p class="wl-lead">{{ s.text | escape }}</p>{%- endif -%}
        <ul class="wl-trust-list">{%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>{%- endfor -%}</ul>
      </div>
      <div>
        <a class="wl-btn" href="#wl-buy">{{ s.button_label | default: 'Add to cart' | escape }}</a>
        <p><a href="{% if crumb %}{{ crumb.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">Continue shopping</a></p>
      </div>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Final CTA",
  "tag": "section",
  "class": "wl-section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "split",
          "label": "Split"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "header",
      "content": "Visibility & layout"
    },
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#5b5bd6"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#5b5bd6"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "inter_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "Heading case",
      "options": [
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button & card radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Verified trust point",
          "default": ""
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "presets": [
    {
      "name": "Final CTA",
      "blocks": [
        {
          "type": "trust"
        }
      ]
    }
  ]
}
{% endschema %}
