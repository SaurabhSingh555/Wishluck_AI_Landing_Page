# Copy this file to .env and fill in your own values. NEVER commit .env.
PORT=3001
FRONTEND_PORT=5173

# Docker Compose root password (MySQL is published on host port 3307 in Docker).
MYSQL_ROOT_PASSWORD=change_me

# MySQL 8 connection. URL-encode special characters in the password (@ -> %40).
# Create the database first: CREATE DATABASE wishluck_studio;
DATABASE_URL=mysql://root:change_me@127.0.0.1:3306/wishluck_studio
DATA_DIR=./data

# Shopify custom app (Admin API scopes: read_themes, write_themes, read_products, write_products)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-10
ALLOW_PUBLISHED_THEME=false

# LLM for product-specific copy. Leave AI_PROVIDER=none for the facts-only rule-based generator.
# Provider: gemini | openai | none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Competitor discovery. Leave empty to add competitor URLs manually in the dashboard.
# Provider: brave | serpapi | none
SEARCH_PROVIDER=none
BRAVE_API_KEY=
SERPAPI_API_KEY=

# Optional: absolute path to a Chromium executable when Playwright's bundled browser is absent.
CHROMIUM_PATH=
